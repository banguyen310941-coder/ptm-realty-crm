# Core CRM production uses Neon Data API / PostgreSQL RPC and does not require DATABASE_URL.
# Do not commit secrets here.

# Optional future outbound channels (configure only when the business credentials are available):
RESEND_API_KEY=
PTM_EMAIL_FROM=
PTM_ZALO_BRIDGE_URL=
PTM_ZALO_BRIDGE_SECRET=
PTM_ZALO_DEFAULT_TEMPLATE=

# Meta Messenger / Facebook Fanpage inbox (server-only secrets)
# For one Page:
PTM_META_APP_SECRET=
PTM_META_PAGE_ID=
PTM_META_PAGE_NAME=
PTM_META_PAGE_ACCESS_TOKEN=
# For multiple Pages, use JSON and leave the single-page values empty.
# Example shape only: [{"page_id":"123","name":"Fanpage A","access_token":"..."}]
PTM_META_PAGES_JSON=
PTM_META_GRAPH_VERSION=v26.0
